<?xml version="1.0" encoding="windows-1251"?>
<string_table>
  <string id="ui_mcm_ammo_maker_compatibility_hint">
    <text>Ammo Maker Патч</text>
  </string>
  <string id="ui_mcm_ammo_maker_compatibility_hint_desc">
    <text>Выключает "разобрать все" меню если установлен мод Ammo Maker</text>
  </string>
  <string id="ui_mcm_enable_addons_submenu_hint">
    <text>Группирувать в подменю "Присоединить/Снять".</text>
  </string>
  <string id="ui_mcm_enable_addons_submenu_hint_desc">
    <text>Собирает пункты присоединения/снятия аддонов оружия (глушитель, прицел, подствольник и тд.) в отдельное подменю вместо главного контекстного меню.</text>
  </string>
  <string id="ui_mcm_enable_quickactions_submenu_hint">
    <text>Группирувать в "Добавить".</text>
  </string>
  <string id="ui_mcm_enable_quickactions_submenu_hint_desc">
    <text>Собирает пункты 'Избранное', 'Мусор' (Sorting Plus) и 'Добавить в колесо' (Haru's Quick Action Wheel) в отдельное подменю "Добавить" вместо главного контекстного меню.</text>
  </string>
  <string id="ui_mcm_hide_equip_unequip_hint">
    <text>Скрыть пункты Надеть/Снять.</text>
  </string>
  <string id="ui_mcm_hide_equip_unequip_hint_desc">
    <text>Убирает из контекстного меню инвентаря пункты 'Надеть', 'Снять костюм', 'Снять с головы', 'Снять рюкзак', 'Убрать в рюкзак' и тд.</text>
  </string>
  <string id="ui_mcm_menu_context_menu">
    <text>Контекстное меню</text>
  </string>
  <string id="ui_mcm_menu_disassemble_all_items">
    <text>Разобрать все</text>
  </string>
  <string id="ui_mcm_menu_qol_works_inventory">
    <text>QOL:Работа с инвентарем</text>
  </string>
  <string id="ui_mcm_menu_tooltip_ctrl">
    <text>Всплывающая подсказка</text>
  </string>
  <string id="ui_mcm_qol_works_inventory_tooltip_hide_keybind">
    <text>Кнопка скрытия тултипов</text>
  </string>
  <string id="ui_mcm_qol_works_inventory_tooltip_hide_speed">
    <text>Задержка появления "тултипа"</text>
  </string>
  <string id="ui_mcm_qol_works_inventory_tooltip_hide_speed_desc">
    <text>\n   1 - Мгновенно(100мс.)\n   5 - Средняя задержка [По умолчанию]\n   10 - Значительная задержка(1000мс.)</text>
  </string>
  <string id="ui_mcm_qol_works_inventory_tooltip_hide_toggle_mode">
    <text>Режим переключателя</text>
  </string>
  <string id="ui_mcm_qol_works_inventory_tooltip_hide_toggle_mode_desc">
    <text>Включено: нажать кнопку - скрыть "тултип", нажать снова - показать.\nВыключено: тултипы скрыты только пока кнопка зажата.</text>
  </string>
  <string id="ui_mcm_qol_works_tooltip_hide_keybind_desc">
    <text>Клавиша, которая скрывает тултипы предметов.</text>
  </string>
</string_table>
