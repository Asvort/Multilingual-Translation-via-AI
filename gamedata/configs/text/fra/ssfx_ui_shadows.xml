  <string id="ui_mcm_ssfx_module_shadows">
    <text>Ombres et éclairage</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_lod_max_mcm">
    <text>Résolution maximale des ombres</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_lod_max_mcm_desc">
    <text>Résolution maximale de la carte d’ombres. Lorsque les sources lumineuses sont proches, la résolution augmente pour améliorer la qualité des ombres au détriment des performances.</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_lod_min_mcm">
    <text>Résolution minimale des ombres</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_lod_min_mcm_desc">
    <text>Résolution minimale de la carte d’ombres. Lorsque les sources lumineuses sont loin du joueur, la résolution baisse pour améliorer les performances au détriment de la qualité d’image.</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_lod_quality_mcm">
    <text>Niveau de détail des ombres</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_lod_quality_mcm_desc">
    <text>Qualité de base de la carte d’ombres. Plus la valeur est élevée, plus la résolution de base et celle des ombres à distance augmentent.</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_title">
    <text>Paramètres des ombres et de l’éclairage</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_volumetric_force_mcm">
    <text>Forcer l’éclairage volumétrique ( rechargement de la carte requis )</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_volumetric_force_mcm_desc">
    <text>Force l’effet volumétrique sur toutes les sources lumineuses non directionnelles. Rechargez la carte pour appliquer le réglage.</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_volumetric_int_mcm">
    <text>Intensité de l’éclairage volumétrique</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_volumetric_int_mcm_desc">
    <text>Définit l’intensité de l’effet volumétrique.</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_volumetric_quality_mcm">
    <text>Qualité de l’éclairage volumétrique</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_volumetric_quality_mcm_desc">
    <text>Définit la qualité de l’effet volumétrique au prix des performances.</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_volumetric_resolution_mcm">
    <text>Résolution de l’éclairage volumétrique</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_volumetric_resolution_mcm_desc">
    <text>Résolution de rendu de l’éclairage volumétrique en proportion de la résolution actuelle. [ min: 14% ~ max: 100% ]</text>
  </string>
</string_table>
