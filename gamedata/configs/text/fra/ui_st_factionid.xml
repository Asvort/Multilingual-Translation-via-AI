  </string>
  <string id="ui_mcm_targetID_speedID_desc">
    <text>Augmente ou réduit la vitesse d’identification. Plus la valeur est élevée, plus le processus est rapide.</text>
  </string>
  <string id="ui_mcm_targetID_talkName">
    <text>Nom à découvrir</text>
  </string>
  <string id="ui_mcm_targetID_talkName_desc">
