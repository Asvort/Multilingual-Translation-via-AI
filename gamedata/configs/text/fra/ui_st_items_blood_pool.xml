<?xml version="1.0" encoding="windows-1252"?>
<string_table>
  <string id="ui_mcm_blood_pool_max_pool_size">
    <text>Taille maximale de la flaque</text>
  </string>
  <string id="ui_mcm_blood_pool_num_of_updates">
    <text>Nombre de mises à jour</text>
  </string>
  <string id="ui_mcm_blood_pool_num_of_updates_desc">
    <text>Davantage de mises à jour rendent l’augmentation plus progressive (la taille maximale ne change pas).</text>
  </string>
  <string id="ui_mcm_blood_pool_pool_lifetime">
    <text>Durée de la flaque (secondes)</text>
  </string>
  <string id="ui_mcm_blood_pool_pool_lifetime_desc">
    <text>Durée de présence de la flaque après son apparition (pool_lifetime - num_of_updates * update_freq = délai avant sa disparition complète).</text>
  </string>
  <string id="ui_mcm_blood_pool_title">
    <text>Flaque de sang</text>
  </string>
  <string id="ui_mcm_blood_pool_update_freq">
    <text>Fréquence de mise à jour (secondes)</text>
  </string>
  <string id="ui_mcm_blood_pool_update_freq_desc">
    <text>Temps entre deux mises à jour. Une valeur plus faible permet à la flaque d’atteindre plus vite sa taille maximale.</text>
  </string>
  <string id="ui_mcm_menu_blood_pool">
    <text>Flaque de sang</text>
  </string>
</string_table>
