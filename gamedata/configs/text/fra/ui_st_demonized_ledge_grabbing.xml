<?xml version="1.0" encoding="windows-1252"?>
<string_table>
  <string id="ui_mcm_demonized_ledge_grabbing_BHSMode">
    <text>Intégration BHS</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_BHSMode_desc">
    <text>Avec Body Health System, un bras cassé empêchera le joueur de grimper.</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_alternativeClimbDetection">
    <text>Détection alternative des rebords</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_alternativeClimbDetection_desc">
    <text>La méthode alternative recherche les rebords plus près du réticule du joueur. La méthode standard effectue la recherche à une hauteur fixe.</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_animationRandomization">
    <text>Variation aléatoire de l’animation</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_animationRandomization_desc">
    <text>Varie aléatoirement le mouvement de la caméra.</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_climbTriggerDistance">
    <text>Distance de déclenchement</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_climbTriggerDistance_desc">
    <text>Distance maximale pour déclencher la saisie d’un rebord.</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_enable">
    <text>Activer</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_gruntProbability">
    <text>Probabilité des grognements</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_gruntVolume">
    <text>Volume des grognements</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_hardcoreMode">
    <text>Mode hardcore</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_hardcoreMode_desc">
    <text>Une fois activé, l’escalade est soumise à des restrictions supplémentaires : \n 1. Impossible de grimper si le joueur pèse plus de 90 kg \n 2. Impossible de grimper si la santé du joueur est inférieure à 60 % \n 3. La consommation d’endurance augmente</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_inputMethod">
    <text>Méthode de saisie</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_jumpTriggerTime">
    <text>Durée d’appui pour déclencher</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_jumpTriggerTime_desc">
    <text>Si vous maintenez la touche plus longtemps, la saisie du rebord s’activera.</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_keybind">
    <text>Touche associée</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_playerWidthCheck">
    <text>Vérifier l’espace pour le joueur</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_playerWidthCheck_desc">
    <text>Si cette option est activée, une vérification supplémentaire détermine si le joueur tient sur le rebord. Certains rebords peuvent alors devenir inaccessibles.</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_raySteps">
    <text>Précision de saisie des rebords</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_raySteps_desc">
    <text>Plus la valeur est élevée, meilleure est la détection et le positionnement, au prix d’une légère baisse des performances.</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_soundVolume">
    <text>Volume sonore</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_staminaDrain">
    <text>Consommation d’endurance</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_throttleCheck">
    <text>Délai de vérification de l’escalade</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_throttleCheck_desc">
    <text>Intervalle entre les vérifications en ms. L’augmenter améliore les performances au détriment de la précision.</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_unstuckCheck">
    <text>Vérifier si le joueur est bloqué</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_unstuckCheck_desc">
    <text>Si cette option est activée, le mod tentera de débloquer le joueur si la saisie du rebord échoue.</text>
  </string>
  <string id="ui_mcm_ledge_grabbing_title">
    <text>Saisie des rebords</text>
  </string>
  <string id="ui_mcm_lst_demonized_ledge_grabbing_inputMethod_both">
    <text>Les deux</text>
  </string>
  <string id="ui_mcm_lst_demonized_ledge_grabbing_inputMethod_buttonPress">
    <text>Appuyer sur le bouton</text>
  </string>
  <string id="ui_mcm_lst_demonized_ledge_grabbing_inputMethod_jumpHold">
    <text>Maintenir la touche</text>
  </string>
  <string id="ui_mcm_menu_demonized_ledge_grabbing">
    <text>Saisie des rebords</text>
  </string>
</string_table>
