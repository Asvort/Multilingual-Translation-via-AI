<?xml version="1.0" encoding="windows-1252"?>
<string_table>
  <string id="ui_mcm_ssfx_module_terrain">
    <text>Terrain</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_distance_mcm">
    <text>Qualité du rendu</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_distance_mcm_desc">
    <text>Règle la distance maximale de rendu du terrain en haute qualité.</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_grass_align_mcm">
    <text>Alignement de l’herbe au terrain (rechargement de la carte requis)</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_grass_align_mcm_desc">
    <text>Aligne l’herbe sur la pente du terrain.</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_grass_slope_mcm">
    <text>Limite de pente pour l’herbe (rechargement de la carte requis)</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_grass_slope_mcm_desc">
    <text>Limite la présence d’herbe lorsque la pente du terrain dépasse l’angle choisi.</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_height_mcm">
    <text>Hauteur de parallaxe</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_height_mcm_desc">
    <text>Règle la hauteur maximale de l’effet de parallaxe.</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_quality_mcm">
    <text>Qualité de la parallaxe</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_quality_mcm_desc">
    <text>Définit la qualité visuelle de l’effet. Les valeurs élevées utilisent davantage d’échantillons pour lisser le résultat.</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_range_mcm">
    <text>Distance de parallaxe</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_range_mcm_desc">
    <text>Définit la distance maximale d’affichage de l’effet de parallaxe.</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_refine_mcm">
    <text>Affinage de la parallaxe</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_refine_mcm_desc">
    <text>Ajoute une étape d’affinage pour améliorer la parallaxe. Activez-la ou désactivez-la pour améliorer la qualité visuelle ou les performances.</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_water_level_mcm">
    <text>Niveau d’eau de la parallaxe</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_water_level_mcm_desc">
    <text>Règle la profondeur maximale des flaques.</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_title">
    <text>Paramètres du terrain</text>
  </string>
</string_table>
