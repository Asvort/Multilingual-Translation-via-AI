<?xml version="1.0" encoding="windows-1250"?>
<string_table>
  <string id="ui_mcm_beef_nvg_nvg_gain_max_mcm">
    <text>Maksymalne wzmocnienie noktowizji</text>
  </string>
  <string id="ui_mcm_beef_nvg_nvg_gain_max_mcm_desc">
    <text>Wyższe wartości zwiększają jasność do limitu. Ustaw nocą przy pogodzie cloudy_dark_2.</text>
  </string>
  <string id="ui_mcm_beef_nvg_nvg_gain_min_mcm">
    <text>Minimalne wzmocnienie noktowizji</text>
  </string>
  <string id="ui_mcm_beef_nvg_nvg_gain_min_mcm_desc">
    <text>Niższe wartości bardziej przyciemniają noktowizję; bardzo niskie pozwalają używać jej w dzień.</text>
  </string>
  <string id="ui_mcm_beef_nvg_nvg_gain_offset_mcm">
    <text>Korekta jasności świata</text>
  </string>
  <string id="ui_mcm_beef_nvg_nvg_gain_offset_mcm_desc">
    <text>1.0 nie zmienia jasności świata. Wyższe wartości ją mnożą, ale nie wpływają na źródła światła.</text>
  </string>
  <string id="ui_mcm_beef_nvg_nvg_gen1_mode_mcm">
    <text>Tło nakładki Gen 1 (domyślnie: brak)</text>
  </string>
  <string id="ui_mcm_beef_nvg_nvg_gen1_mode_mcm_desc">
    <text>Wybierz tło nakładki.</text>
  </string>
  <string id="ui_mcm_beef_nvg_nvg_gen1_tubes_mcm">
    <text>Konfiguracja tub Gen 1 (domyślnie: jedna na środku)</text>
  </string>
  <string id="ui_mcm_beef_nvg_nvg_gen1_tubes_mcm_desc">
    <text>Wybierz liczbę i układ tub Gen 1.</text>
  </string>
  <string id="ui_mcm_beef_nvg_nvg_gen2_mode_mcm">
    <text>Tło nakładki Gen 2 (domyślnie: rozmyte)</text>
  </string>
  <string id="ui_mcm_beef_nvg_nvg_gen2_mode_mcm_desc">
    <text>Wybierz tło nakładki.</text>
  </string>
  <string id="ui_mcm_beef_nvg_nvg_gen2_tubes_mcm">
