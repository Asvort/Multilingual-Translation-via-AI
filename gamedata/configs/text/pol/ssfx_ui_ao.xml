    <text>Maksymalna odległość sprawdzania okluzji piksela. Jej zwiększenie może wymagać zmiany intensywności efektu.</text>
  </string>
  <string id="ui_mcm_ssfx_module_ao_res_mcm">
    <text>Rozdzielczość</text>
  </string>
  <string id="ui_mcm_ssfx_module_ao_res_mcm_desc">
    <text>Rozdzielczość renderowania okluzji otoczenia.</text>
  </string>
  <string id="ui_mcm_ssfx_module_ao_title">
    <text>Ustawienia okluzji otoczenia</text>
  </string>
