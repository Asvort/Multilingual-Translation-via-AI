<?xml version="1.0" encoding="windows-1250"?>
<string_table>
  <string id="ui_mcm_heatvision_nvg_body_cooldown_mcm">
    <text>Ciała stygną z upływem czasu:</text>
  </string>
  <string id="ui_mcm_heatvision_nvg_body_cooldown_mcm_desc">
    <text>Po włączeniu ciała NPC i mutantów stygną z czasem. Po wyłączeniu zawsze są widoczne jako ciepłe.</text>
  </string>
  <string id="ui_mcm_heatvision_nvg_body_cooldown_time_mcm">
    <text>Czas pełnego ostygnięcia ciała (w sekundach):</text>
  </string>
  <string id="ui_mcm_heatvision_nvg_body_cooldown_time_mcm_desc">
    <text>Liczba sekund potrzebna, by ciało po śmierci całkowicie utraciło ciepło.</text>
  </string>
  <string id="ui_mcm_heatvision_nvg_mode_mcm">
    <text>Nakładka tła:</text>
  </string>
  <string id="ui_mcm_heatvision_nvg_mode_mcm_desc">
    <text>Wybierz nakładkę tła. Domyślnie: rozmyta nakładka.</text>
  </string>
  <string id="ui_mcm_heatvision_nvg_stays_pda_mcm">
    <text>Wizjer termiczny pozostaje włączony podczas przeglądania PDA:</text>
  </string>
  <string id="ui_mcm_heatvision_nvg_stays_pda_mcm_desc">
    <text>Po wyłączeniu wizjer termiczny wyłącza się automatycznie podczas przeglądania PDA.</text>
  </string>
  <string id="ui_mcm_heatvision_nvg_tubes_mcm">
    <text>Układ tub:</text>
  </string>
  <string id="ui_mcm_heatvision_nvg_tubes_mcm_desc">
    <text>Wybierz liczbę i układ tub. Domyślnie: cztery tuby pośrodku.</text>
  </string>
  <string id="ui_mcm_heatvision_nvg_view_through_scope_mcm">
    <text>Używaj wizjera termicznego podczas celowania:</text>
  </string>
  <string id="ui_mcm_heatvision_nvg_view_through_scope_mcm_desc">
    <text>Po włączeniu wizjer termiczny pozostaje aktywny podczas celowania. Po wyłączeniu postać wyłącza noktowizor przy podnoszeniu broni.</text>
  </string>
  <string id="ui_mcm_heatvision_title">
    <text>Ustawienia HeatVision</text>
  </string>
  <string id="ui_mcm_menu_heatvision">
    <text>HeatVision</text>
  </string>
</string_table>
