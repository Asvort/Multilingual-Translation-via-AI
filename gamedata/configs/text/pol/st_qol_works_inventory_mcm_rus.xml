<?xml version="1.0" encoding="windows-1250"?>
<string_table>
  <string id="ui_mcm_ammo_maker_compatibility_hint">
    <text>Łatka Ammo Maker</text>
  </string>
  <string id="ui_mcm_ammo_maker_compatibility_hint_desc">
    <text>Wyłącza menu „Rozłóż wszystko”, jeśli zainstalowano mod Ammo Maker.</text>
  </string>
  <string id="ui_mcm_enable_addons_submenu_hint">
    <text>Grupuj w podmenu „Zamocuj/Odłącz”.</text>
  </string>
  <string id="ui_mcm_enable_addons_submenu_hint_desc">
    <text>Zbiera opcje mocowania i odłączania dodatków do broni (tłumik, celownik, granatnik pod lufą itp.) w osobnym podmenu.</text>
  </string>
  <string id="ui_mcm_enable_quickactions_submenu_hint">
    <text>Grupuj w „Dodaj”.</text>
  </string>
  <string id="ui_mcm_enable_quickactions_submenu_hint_desc">
    <text>Zbiera opcje „Ulubione”, „Śmieci” (Sorting Plus) i „Dodaj do koła” (Haru's Quick Action Wheel) w osobnym podmenu „Dodaj”.</text>
  </string>
  <string id="ui_mcm_hide_equip_unequip_hint">
    <text>Ukryj opcje Załóż/Zdejmij.</text>
  </string>
  <string id="ui_mcm_hide_equip_unequip_hint_desc">
    <text>Usuwa z menu kontekstowego ekwipunku opcje „Załóż”, „Zdejmij kombinezon”, „Zdejmij nakrycie głowy”, „Zdejmij plecak”, „Włóż do plecaka” i podobne.</text>
  </string>
  <string id="ui_mcm_menu_context_menu">
    <text>Menu kontekstowe</text>
  </string>
  <string id="ui_mcm_menu_disassemble_all_items">
    <text>Rozłóż wszystko</text>
  </string>
  <string id="ui_mcm_menu_qol_works_inventory">
    <text>QOL: Zarządzanie ekwipunkiem</text>
  </string>
  <string id="ui_mcm_menu_tooltip_ctrl">
    <text>Podpowiedź</text>
  </string>
  <string id="ui_mcm_qol_works_inventory_tooltip_hide_keybind">
    <text>Klawisz ukrywania podpowiedzi</text>
  </string>
  <string id="ui_mcm_qol_works_inventory_tooltip_hide_speed">
    <text>Opóźnienie wyświetlenia podpowiedzi</text>
  </string>
  <string id="ui_mcm_qol_works_inventory_tooltip_hide_speed_desc">
    <text>\n   1 - Natychmiast (100 ms)\n   5 - Średnie opóźnienie [domyślnie]\n   10 - Znaczne opóźnienie (1000 ms)</text>
  </string>
  <string id="ui_mcm_qol_works_inventory_tooltip_hide_toggle_mode">
    <text>Tryb przełączania</text>
  </string>
  <string id="ui_mcm_qol_works_inventory_tooltip_hide_toggle_mode_desc">
    <text>Włączone: naciśnij klawisz, aby ukryć podpowiedź; naciśnij ponownie, aby ją pokazać.\nWyłączone: podpowiedzi są ukryte tylko podczas przytrzymywania klawisza.</text>
  </string>
  <string id="ui_mcm_qol_works_tooltip_hide_keybind_desc">
    <text>Klawisz ukrywający podpowiedzi przedmiotów.</text>
  </string>
</string_table>
