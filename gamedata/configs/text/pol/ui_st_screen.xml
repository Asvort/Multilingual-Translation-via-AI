  <string id="bar_arena_fight_bloodsucker">
    <text>Uwaga! Uwaga! Na Arenie zaraz rozpocznie się nowa walka! W lewym narożniku koszmar budzący największy postrach w Zonie, wiecznie głodny pijaw! A w prawym... człowiek? Tak, to człowiek! Oklaski dla stalkera!</text>
  </string>
  <string id="bar_arena_fight_burer">
    <text>Uwaga! Uwaga! Na Arenie zaraz rozpocznie się nowa walka! W lewym narożniku sam mistrz kung-fu wyginający łyżki — burier! W prawym narożniku stalker, który stale ma się na baczności!</text>
  </string>
  <string id="bar_arena_fight_dead">
    <text>Pretendent został zabity! Ale niespodzianka!</text>
  </string>
  <string id="bar_arena_fight_lose">
    <text>Pretendent zabił przeciwnika, ale nie zdążył. Przegrywa walkę!</text>
  </string>
  <string id="bar_arena_fight_pseudodog">
    <text>Uwaga! Uwaga! Na Arenie zaraz rozpocznie się nowa walka. W lewym narożniku biały, puchaty i wściekły jak diabli... pseudopies! W prawym ktoś, kto przybył znikąd i właśnie tam zmierza z powrotem.</text>
  </string>
  <string id="bar_arena_fight_savage">
    <text>Uwaga! Uwaga! Na Arenie zaraz rozpocznie się nowa walka. W lewym narożniku dobrze go znacie, kochacie, a on nienawidzi was tak samo: Bestia! W prawym narożniku nasz stalker, żywy i kopiący, przynajmniej na razie!</text>
  </string>
  <string id="bar_arena_fight_snork">
    <text>Uwaga! Uwaga! Na Arenie zaraz rozpocznie się nowa walka. W lewym narożniku guru sztuk walki i specjalista od zdrowia — snork! W prawym narożniku człowiek bez przeszłości i przyszłości.</text>
  </string>
  <string id="bar_arena_fight_timeout">
    <text>Czas minął! Pretendent przegrał, ale nadal walczy o życie!</text>
  </string>
  <string id="bar_arena_fight_victory">
    <text>Brawo! Pretendent na czas zabił przeciwnika i wygrał!</text>
  </string>
