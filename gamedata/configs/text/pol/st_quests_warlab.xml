<?xml version="1.0" encoding="windows-1250"?>
<string_table>
  <string id="sar_perception">
    <text>Północne przejście</text>
  </string>
  <string id="sar_perception_1">
    <text>Spotkaj się z kimkolwiek lub czymkolwiek, co stoi za Monolitem.</text>
  </string>
  <string id="sar_perception_2">
    <text>Znajdź laboratorium wspomniane w manuskrypcie i odkryj, co skrywa.</text>
  </string>
  <string id="sar_perception_3">
    <text>Użyj dekodera, aby otworzyć drzwi.</text>
  </string>
  <string id="sar_perception_4">
    <text>Pokonaj strażników, aby dostać się do pomieszczenia.</text>
  </string>
  <string id="sar_perception_5">
    <text>Odczytaj kod wejściowy z dokumentów.</text>
  </string>
  <string id="warlab_kill_crazy_entity_1">
    <text>Porozmawiaj z bytem</text>
  </string>
  <string id="warlab_kill_crazy_entity_2">
    <text>Zabij trzy fizyczne postacie bytu z laboratorium wojskowego, aby otworzyć drzwi</text>
  </string>
  <string id="warlab_kill_crazy_entity_title">
    <text>Rozpraw się z nieznanym bytem</text>
  </string>
</string_table>
