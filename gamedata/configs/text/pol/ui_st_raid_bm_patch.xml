  <string id="st_bm_uniq_exo_csky_descr">
    <text>Egzoszkielet Czystego Nieba jest jednym z najstarszych w Zonie. Przywrócony do stanu fabrycznego.</text>
  </string>
  <string id="st_bm_uniq_exo_csky_name">
    <text>Egzoszkielet Czystego Nieba CH-5</text>
  </string>
  <string id="st_bm_uniq_exo_greh_descr">
    <text>Egzoszkielet z symboliką Grzechu — ciężki, opancerzony, bez kompromisów. Kula go nie ruszy, sumienie tym bardziej.</text>
  </string>
  <string id="st_bm_uniq_exo_greh_name">
    <text>Egzoszkielet Grzechu</text>
  </string>
  <string id="st_bm_uniq_exo_isg_descr">
    <text>Bojowy egzoszkielet ISG. Trafił do nas poza wszystkimi kanałami — nie każdy może go nosić.</text>
  </string>
  <string id="st_bm_uniq_exo_isg_name">
    <text>Egzoszkielet ISG</text>
  </string>
  <string id="st_bm_uniq_gauss_descr">
