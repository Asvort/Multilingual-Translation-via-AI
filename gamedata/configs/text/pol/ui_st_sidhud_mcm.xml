<?xml version="1.0" encoding="windows-1250"?>
<string_table>
  <string id="ui_mcm_menu_sidhud">
    <text>SidHUD</text>
  </string>
  <string id="ui_mcm_sidhud_ammoshow">
    <text>Łączny licznik amunicji</text>
  </string>
  <string id="ui_mcm_sidhud_ammoshow_desc">
    <text>Pokazuje ŁĄCZNĄ liczbę nabojów każdego z 3 typów dostępnych w ekwipunku.</text>
  </string>
  <string id="ui_mcm_sidhud_armorbar">
    <text>Pasek stanu pancerza</text>
  </string>
  <string id="ui_mcm_sidhud_armorbar_desc">
    <text>Pokazuje pasek stanu pancerza.</text>
  </string>
  <string id="ui_mcm_sidhud_armortext">
    <text>Tekst stanu pancerza</text>
  </string>
  <string id="ui_mcm_sidhud_armortext_desc">
    <text>Pokazuje stan pancerza w procentach, turkusowym tekstem. \n%c[ui_gray_2]Nie działa, gdy pasek jest wyłączony.</text>
  </string>
  <string id="ui_mcm_sidhud_bleedingbarshow">
    <text>Pasek krwawienia</text>
  </string>
  <string id="ui_mcm_sidhud_bleedingbarshow_desc">
    <text>Pokazuje ilość traconej krwi na pasku wytrzymałości, od lewej do prawej. </text>
  </string>
  <string id="ui_mcm_sidhud_healingbar">
    <text>Pasek przewidywanego leczenia</text>
  </string>
  <string id="ui_mcm_sidhud_healingbar_desc">
    <text>Dodaje do paska zdrowia subtelny wskaźnik dokładnej ilości zdrowia odzyskiwanej po użyciu przedmiotu leczniczego.</text>
  </string>
  <string id="ui_mcm_sidhud_oldammoshow">
    <text>Stara amunicja</text>
  </string>
  <string id="ui_mcm_sidhud_oldammoshow_desc">
    <text>Pokazuje starą amunicję, gdy ma to zastosowanie (na przykład gdy nie ma jej „ulepszonych” odpowiedników).</text>
  </string>
  <string id="ui_mcm_sidhud_radhealthshow">
    <text>Pasek napromieniowania</text>
  </string>
  <string id="ui_mcm_sidhud_radhealthshow_desc">
    <text>Pokazuje poziom promieniowania na pasku zdrowia, od lewej do prawej. </text>
  </string>
  <string id="ui_mcm_sidhud_sidslide">
    <text>Opcje SidHUD</text>
  </string>
  <string id="ui_mcm_sidhud_weaponbarhide">
    <text>Ukryj po zdjęciu</text>
  </string>
  <string id="ui_mcm_sidhud_weaponbarhide_desc">
    <text>Ukrywa pasek stanu broni po jej zdjęciu. \n%c[ui_gray_2]Nie działa, gdy pasek jest wyłączony.</text>
  </string>
  <string id="ui_mcm_sidhud_weaponshow">
    <text>Pasek stanu broni</text>
  </string>
  <string id="ui_mcm_sidhud_weaponshow_desc">
    <text>Pokazuje pasek stanu broni.</text>
  </string>
  <string id="ui_mcm_sidhud_weapontext">
    <text>Tekst stanu broni</text>
  </string>
  <string id="ui_mcm_sidhud_weapontext_desc">
    <text>Pokazuje stan broni w procentach pomarańczowym tekstem. \n%c[ui_gray_2]Nie działa, gdy pasek jest wyłączony.</text>
  </string>
</string_table>
