<?xml version="1.0" encoding="windows-1250"?>
<string_table>
  <string id="ui_mcm_ssfx_module_sss">
    <text>SSS</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_enable_dir_mcm">
    <text>Włącz cienie świateł kierunkowych</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_enable_dir_mcm_desc">
    <text>Włącza lub wyłącza cienie w przestrzeni ekranu dla świateł kierunkowych (słońce i księżyc).</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_enable_point_mcm">
    <text>Włącz cienie świateł punktowych</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_enable_point_mcm_desc">
    <text>Włącza lub wyłącza cienie w przestrzeni ekranu dla świateł punktowych (żarówki, ogniska itp.).</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_len_dir_mcm">
    <text>Długość cieni świateł kierunkowych</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_len_dir_mcm_desc">
    <text>Reguluje maksymalną długość cieni świateł kierunkowych.</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_len_point_mcm">
    <text>Długość cieni świateł punktowych</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_len_point_mcm_desc">
    <text>Reguluje maksymalną długość wszystkich cieni świateł punktowych.</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_quality_dir_mcm">
    <text>Jakość świateł kierunkowych</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_quality_dir_mcm_desc">
    <text>Liczba próbek cieni świateł kierunkowych (słońce i księżyc). Więcej próbek poprawia wyrazistość cieni. [ 6 - 12 - 18 - 24 ]</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_quality_point_mcm">
    <text>Jakość świateł punktowych</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_quality_point_mcm_desc">
    <text>Liczba próbek cieni świateł punktowych (żarówki, ogniska itp.). Więcej próbek poprawia wyrazistość cieni. [ 2 - 4 - 6 - 8 ]</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_title">
    <text>Ustawienia cieni w przestrzeni ekranu</text>
  </string>
