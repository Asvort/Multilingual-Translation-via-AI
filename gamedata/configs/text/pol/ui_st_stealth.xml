  <string id="ui_mcm_stealth_icon">
    <text>Ikona</text>
  </string>
  <string id="ui_mcm_stealth_icon_desc">
    <text>Ikona jasności (pokazuje światło na postaci).</text>
  </string>
  <string id="ui_mcm_stealth_icon_type">
    <text>Typ ikony</text>
  </string>
  <string id="ui_mcm_stealth_icon_type_desc">
    <text>1) Wskaźnik światła pokazuje ilość światła padającego na gracza. \n \n2) Wzrok NPC pokazuje, jak widzi gracza NPC o najwyższej wartości widzenia: \n- Biała ikona: NPC jest w normalnym stanie i nie widzi gracza; \n- Żółta ikona: NPC walczy lub jest w stanie zagrożenia, ma wzmocniony wzrok, ale nie widzi gracza; \n- Czerwona ikona: NPC widzi gracza.</text>
  </string>
  <string id="ui_mcm_stealth_icon_x">
    <text>Pozycja ikony X</text>
  </string>
  <string id="ui_mcm_stealth_icon_y">
    <text>Pozycja ikony Y</text>
  </string>
  <string id="ui_mcm_stealth_low_crouch">
    <text>Niskie kucanie</text>
  </string>
  <string id="ui_mcm_stealth_low_crouch_desc">
