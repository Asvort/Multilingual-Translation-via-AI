    <text>Desenfoque de movimiento - Ajustes</text>
  </string>
  <string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_camera_mcm">
    <text>Intensidad del movimiento de cámara</text>
  </string>
  <string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_camera_mcm_desc">
    <text>Ajusta o desactiva por completo el desenfoque causado por el movimiento de la cámara.</text>
  </string>
  <string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_hudonly_mcm">
