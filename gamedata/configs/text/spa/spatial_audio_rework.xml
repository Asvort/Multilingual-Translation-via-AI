  <string id="ui_mcm_spatial_audio_sar_main_lower_threshold_desc">
    <text>Si la puntuación de interior (la cantidad de impactos del rayo) supera este umbral, la reverberación empieza a afectar al sonido.</text>
  </string>
  <string id="ui_mcm_spatial_audio_sar_main_mid_length">
