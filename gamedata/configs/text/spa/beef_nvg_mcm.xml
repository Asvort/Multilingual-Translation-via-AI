<?xml version="1.0" encoding="windows-1252"?>
<string_table>
  <string id="ui_mcm_beef_nvg_nvg_gain_max_mcm">
    <text>Ganancia máxima de NVG</text>
  </string>
  <string id="ui_mcm_beef_nvg_nvg_gain_max_mcm_desc">
    <text>Los valores altos aumentan el brillo hasta un límite. Ajústalo de noche con el clima cloudy_dark_2.</text>
  </string>
  <string id="ui_mcm_beef_nvg_nvg_gain_min_mcm">
    <text>Ganancia mínima de NVG</text>
  </string>
  <string id="ui_mcm_beef_nvg_nvg_gain_min_mcm_desc">
    <text>Los valores bajos oscurecen más las NVG; los muy bajos permiten usarlas de día.</text>
  </string>
  <string id="ui_mcm_beef_nvg_nvg_gain_offset_mcm">
    <text>Ajuste del brillo del mundo</text>
  </string>
  <string id="ui_mcm_beef_nvg_nvg_gain_offset_mcm_desc">
    <text>1.0 mantiene el brillo del mundo. Los valores mayores lo multiplican, pero no afectan a las fuentes de luz.</text>
  </string>
  <string id="ui_mcm_beef_nvg_nvg_gen1_mode_mcm">
