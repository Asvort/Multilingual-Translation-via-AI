<?xml version="1.0" encoding="windows-1252"?>
<string_table>
  <string id="ui_mcm_drx_da_anomaly_amount_modifier">
    <text>Modificador de cantidad de anomalías</text>
  </string>
  <string id="ui_mcm_drx_da_anomaly_amount_modifier_desc">
    <text>Cambia cuántas anomalías puede contener cada zona</text>
  </string>
  <string id="ui_mcm_drx_da_anomaly_zone_anomalies_distance_max">
    <text>Radio de la zona de anomalías</text>
  </string>
  <string id="ui_mcm_drx_da_anomaly_zone_anomalies_distance_max_desc">
    <text>Distancia máxima desde el centro del terreno inteligente hasta la zona de anomalías</text>
  </string>
  <string id="ui_mcm_drx_da_anomaly_zone_anomalies_distance_min">
    <text>Distancia mínima entre anomalías</text>
  </string>
  <string id="ui_mcm_drx_da_anomaly_zone_anomalies_distance_min_desc">
    <text>Distancia mínima entre anomalías de una zona. Los valores negativos permiten que se solapen.</text>
  </string>
  <string id="ui_mcm_drx_da_anomaly_zone_spawn_chance">
    <text>Probabilidad de aparición de zona de anomalías</text>
  </string>
  <string id="ui_mcm_drx_da_anomaly_zone_spawn_chance_desc">
    <text>Probabilidad de que un terreno inteligente genere una zona de anomalías</text>
  </string>
  <string id="ui_mcm_drx_da_artefacts_spawn_chance">
    <text>Probabilidad de aparición de artefactos</text>
  </string>
  <string id="ui_mcm_drx_da_artefacts_spawn_chance_desc">
    <text>Cada artefacto hasta el máximo tiene esta probabilidad de aparecer</text>
  </string>
  <string id="ui_mcm_drx_da_choose_help">
    <text>Debajo puedes activar selectivamente\n qué nuevos tipos de anomalías aparecerán en el juego.</text>
  </string>
  <string id="ui_mcm_drx_da_debug_mode">
    <text>Modo de depuración</text>
  </string>
  <string id="ui_mcm_drx_da_debug_mode_desc">
    <text>Activa el envío masivo de mensajes a la consola</text>
  </string>
  <string id="ui_mcm_drx_da_delete_dynamic_anomalies">
    <text>Eliminar anomalías dinámicas</text>
  </string>
  <string id="ui_mcm_drx_da_delete_dynamic_anomalies_desc">
    <text>Elimina todas las zonas generadas. Para quitar el mod con seguridad, activa la opción, vuelve al juego, guarda, sal y elimina el mod.</text>
  </string>
  <string id="ui_mcm_drx_da_disable_new_anomalies">
    <text>Desactivar nuevas anomalías</text>
  </string>
  <string id="ui_mcm_drx_da_disable_new_anomalies_desc">
    <text>Impide que aparezcan nuevos tipos. Se aplica tras la próxima emisión, tormenta psi o al iniciar una partida nueva.</text>
  </string>
  <string id="ui_mcm_drx_da_electric_field_modifier">
    <text>Modificador del campo eléctrico</text>
  </string>
  <string id="ui_mcm_drx_da_electric_field_modifier_desc">
    <text>Cambia el daño de los campos eléctricos, pero no afecta a los fallos de dispositivos.</text>
  </string>
  <string id="ui_mcm_drx_da_enable_anomalies_behaviour">
    <text>Activar comportamiento dinámico de anomalías</text>
  </string>
  <string id="ui_mcm_drx_da_enable_anomalies_behaviour_desc">
    <text>Determina si las anomalías dinámicas aparecen y desaparecen en la Zona.</text>
  </string>
  <string id="ui_mcm_drx_da_gravitational_shake_modifier">
    <text>Modificador de temblor gravitacional</text>
  </string>
  <string id="ui_mcm_drx_da_gravitational_shake_modifier_desc">
    <text>Cambia el temblor de pantalla cerca de anomalías gravitacionales</text>
  </string>
  <string id="ui_mcm_drx_da_max_artefacts_per_zone">
    <text>Máximo de artefactos por zona</text>
  </string>
  <string id="ui_mcm_drx_da_max_artefacts_per_zone_desc">
    <text>Define el máximo de artefactos que pueden aparecer en una zona</text>
  </string>
  <string id="ui_mcm_drx_da_presets">
    <text>Ajustes predefinidos</text>
  </string>
  <string id="ui_mcm_drx_da_presets_desc">
    <text>Elige ajustes predefinidos de la lista</text>
  </string>
  <string id="ui_mcm_drx_da_random_artefact_spawn_chance">
    <text>Probabilidad de artefacto aleatorio</text>
  </string>
  <string id="ui_mcm_drx_da_random_artefact_spawn_chance_desc">
    <text>El nivel determina los artefactos posibles: al sur aparecen los débiles y en el norte o bajo tierra, los fuertes. Este valor permite que aparezca cualquiera, incluso uno único.</text>
  </string>
  <string id="ui_mcm_drx_da_save_after_cleanup">
    <text>Guardar partida tras eliminar anomalías</text>
  </string>
  <string id="ui_mcm_drx_da_save_after_cleanup_desc">
    <text>Guarda tras una emisión o tormenta psi que elimine anomalías dinámicas del nivel.</text>
  </string>
