<?xml version="1.0" encoding="windows-1254"?>
<string_table>
  <string id="exchanging_items_phr_0">
    <text>Hey dostum, kimin daha çok eşyası var bakalım.</text>
  </string>
  <string id="exchanging_items_phr_1">
    <text>Evet, neden takas yapmıyoruz? Sunabileceğim şeyler bunlar.</text>
  </string>
  <string id="exchanging_items_phr_10">
    <text>Sen bilirsin.</text>
  </string>
  <string id="exchanging_items_phr_2">
    <text>Artefaktı alacağım...</text>
  </string>
  <string id="exchanging_items_phr_3">
    <text>Giysiyi alacağım...</text>
  </string>
  <string id="exchanging_items_phr_4">
    <text>Eşyayı alacağım...</text>
  </string>
  <string id="exchanging_items_phr_5">
    <text>Silahı alacağım...</text>
  </string>
  <string id="exchanging_items_phr_6">
    <text>Güzel. Karşılığında bunu alacağım.</text>
  </string>
  <string id="exchanging_items_phr_7">
    <text>Bana değecek bir şeyin olmadığına göre konuşacak pek bir şeyimiz yok. Biraz daha paran olunca gel.</text>
  </string>
  <string id="exchanging_items_phr_8">
    <text>Pekâlâ, takas yapalım.</text>
  </string>
  <string id="exchanging_items_phr_9">
    <text>Takasla ilgili fikrimi değiştirdim.</text>
  </string>
</string_table>
