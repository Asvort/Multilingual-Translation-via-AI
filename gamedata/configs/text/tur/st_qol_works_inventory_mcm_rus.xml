<?xml version="1.0" encoding="windows-1254"?>
<string_table>
  <string id="ui_mcm_ammo_maker_compatibility_hint">
    <text>Ammo Maker yaması</text>
  </string>
  <string id="ui_mcm_ammo_maker_compatibility_hint_desc">
    <text>Ammo Maker modu yüklüyse "Tümünü sök" menüsünü devre dışı bırakır.</text>
  </string>
  <string id="ui_mcm_enable_addons_submenu_hint">
    <text>"Tak/Çıkar" alt menüsünde grupla.</text>
  </string>
  <string id="ui_mcm_enable_addons_submenu_hint_desc">
    <text>Silah eklentilerini (susturucu, dürbün, namlu altı eklentisi vb.) takma/çıkarma seçeneklerini ana bağlam menüsü yerine ayrı bir alt menüde toplar.</text>
  </string>
  <string id="ui_mcm_enable_quickactions_submenu_hint">
    <text>"Ekle" altında grupla.</text>
  </string>
  <string id="ui_mcm_enable_quickactions_submenu_hint_desc">
    <text>"Favoriler", "Çöp" (Sorting Plus) ve "Tekere ekle" (Haru's Quick Action Wheel) seçeneklerini ana bağlam menüsü yerine ayrı bir "Ekle" alt menüsünde toplar.</text>
  </string>
  <string id="ui_mcm_hide_equip_unequip_hint">
    <text>Giy/Çıkar seçeneklerini gizle.</text>
  </string>
  <string id="ui_mcm_hide_equip_unequip_hint_desc">
    <text>Envanter bağlam menüsünden "Giy", "Kıyafeti çıkar", "Başlığı çıkar", "Sırt çantasını çıkar", "Çantaya koy" ve benzeri seçenekleri kaldırır.</text>
  </string>
  <string id="ui_mcm_menu_context_menu">
    <text>Bağlam menüsü</text>
  </string>
  <string id="ui_mcm_menu_disassemble_all_items">
    <text>Tümünü sök</text>
  </string>
  <string id="ui_mcm_menu_qol_works_inventory">
    <text>QOL: Envanter Yönetimi</text>
  </string>
  <string id="ui_mcm_menu_tooltip_ctrl">
    <text>Araç ipucu</text>
  </string>
  <string id="ui_mcm_qol_works_inventory_tooltip_hide_keybind">
    <text>Araç ipucunu gizleme tuşu</text>
  </string>
  <string id="ui_mcm_qol_works_inventory_tooltip_hide_speed">
    <text>Araç ipucu görünme gecikmesi</text>
  </string>
  <string id="ui_mcm_qol_works_inventory_tooltip_hide_speed_desc">
    <text>\n   1 - Anında (100 ms)\n   5 - Orta gecikme [varsayılan]\n   10 - Belirgin gecikme (1000 ms)</text>
  </string>
  <string id="ui_mcm_qol_works_inventory_tooltip_hide_toggle_mode">
    <text>Geçiş modu</text>
  </string>
  <string id="ui_mcm_qol_works_inventory_tooltip_hide_toggle_mode_desc">
    <text>Açık: ipucunu gizlemek için tuşa bas, göstermek için yeniden bas.\nKapalı: ipuçları yalnızca tuş basılı tutulurken gizlenir.</text>
  </string>
  <string id="ui_mcm_qol_works_tooltip_hide_keybind_desc">
    <text>Eşya ipuçlarını gizleyen tuş.</text>
  </string>
</string_table>
