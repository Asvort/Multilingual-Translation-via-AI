<?xml version="1.0" encoding="windows-1254"?>
<string_table>
  <string id="ui_mcm_menu_sidhud">
    <text>SidHUD</text>
  </string>
  <string id="ui_mcm_sidhud_ammoshow">
    <text>Toplam cephane sayacı</text>
  </string>
  <string id="ui_mcm_sidhud_ammoshow_desc">
    <text>Envanterde bulunan 3 türün her birinden sahip olduğunuz TOPLAM cephane miktarını gösterir.</text>
  </string>
  <string id="ui_mcm_sidhud_armorbar">
    <text>Zırh durumu çubuğu</text>
  </string>
  <string id="ui_mcm_sidhud_armorbar_desc">
    <text>Zırh durumu çubuğunu gösterir.</text>
  </string>
  <string id="ui_mcm_sidhud_armortext">
    <text>Zırh durumu metni</text>
  </string>
  <string id="ui_mcm_sidhud_armortext_desc">
    <text>Zırh durumunu camgöbeği renkte yüzde olarak gösterir. \n%c[ui_gray_2]Çubuk devre dışıysa etkisi olmaz.</text>
  </string>
  <string id="ui_mcm_sidhud_bleedingbarshow">
    <text>Kanama çubuğu</text>
  </string>
  <string id="ui_mcm_sidhud_bleedingbarshow_desc">
    <text>Kaybettiğiniz kan miktarını dayanıklılık çubuğunda soldan sağa gösterir. </text>
  </string>
  <string id="ui_mcm_sidhud_healingbar">
    <text>İyileşme tahmin çubuğu</text>
  </string>
  <string id="ui_mcm_sidhud_healingbar_desc">
    <text>Sağlık çubuğuna, bir iyileştirme eşyası kullanıldığında kazanacağınız sağlık miktarını tam olarak gösteren ince bir çubuk ekler.</text>
  </string>
  <string id="ui_mcm_sidhud_oldammoshow">
    <text>Eski cephane</text>
  </string>
  <string id="ui_mcm_sidhud_oldammoshow_desc">
    <text>Eski cephaneyi uygun olduğunda gösterir (örneğin, bunun “iyileştirilmiş” bir karşılığı yoksa).</text>
  </string>
  <string id="ui_mcm_sidhud_radhealthshow">
    <text>Radyasyon maruziyeti çubuğu</text>
  </string>
  <string id="ui_mcm_sidhud_radhealthshow_desc">
    <text>Radyasyon miktarını sağlık çubuğunda soldan sağa gösterir. </text>
  </string>
  <string id="ui_mcm_sidhud_sidslide">
    <text>SidHUD seçenekleri</text>
  </string>
  <string id="ui_mcm_sidhud_weaponbarhide">
    <text>Kuşanılmadığında gizle</text>
  </string>
  <string id="ui_mcm_sidhud_weaponbarhide_desc">
    <text>Silah kuşanılmadığında durum çubuğunu gizler. \n%c[ui_gray_2]Çubuk devre dışıysa etkisi olmaz.</text>
  </string>
  <string id="ui_mcm_sidhud_weaponshow">
    <text>Silah durumu çubuğu</text>
  </string>
  <string id="ui_mcm_sidhud_weaponshow_desc">
    <text>Silah durumu çubuğunu gösterir.</text>
  </string>
  <string id="ui_mcm_sidhud_weapontext">
    <text>Silah durumu metni</text>
  </string>
  <string id="ui_mcm_sidhud_weapontext_desc">
    <text>Silah durumunu turuncu renkte yüzde olarak gösterir. \n%c[ui_gray_2]Çubuk devre dışıysa etkisi olmaz.</text>
  </string>
</string_table>
