  </string>
  <string id="ui_mcm_mai_combat_miss_multiplier">
    <text>Em combate</text>
  </string>
  <string id="ui_mcm_mai_combat_miss_multiplier_desc">
    <text>Multiplicador de erro em combate. NPCs distraídos entram mais em anomalias. Padrão: 3,0x</text>
  </string>
  <string id="ui_mcm_mai_damage_title">
