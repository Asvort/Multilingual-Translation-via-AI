<?xml version="1.0" encoding="windows-1252"?>
<string_table>
  <string id="ui_mcm_mai_base_detection_radius">
    <text>Raio de detecção (m)</text>
  </string>
  <string id="ui_mcm_mai_base_detection_radius_desc">
    <text>Distância para NPCs detectarem anomalias. Maior = detecção antecipada e mais restrições de rota. Padrão: 30 m</text>
  </string>
  <string id="ui_mcm_mai_block_anomalies_on_corpses">
    <text>Bloquear em cadáveres</text>
  </string>
  <string id="ui_mcm_mai_block_anomalies_on_corpses_desc">
    <text>Impede anomalias em cadáveres. Evita falhas de física ragdoll e melhora o desempenho.</text>
  </string>
  <string id="ui_mcm_mai_cache_rebuild_delay">
