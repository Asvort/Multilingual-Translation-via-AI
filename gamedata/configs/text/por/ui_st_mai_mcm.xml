    <text>Atraso antes de reconstruir o cache após emissão ou tempestade psi. Necessário para Arrival. Padrão: 2,5 s</text>
  </string>
  <string id="ui_mcm_mai_cleanup_map_markers">
    <text>Limpar marcadores antigos</text>
  </string>
  <string id="ui_mcm_mai_cleanup_map_markers_desc">
