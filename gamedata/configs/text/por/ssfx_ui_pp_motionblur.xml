<?xml version="1.0" encoding="windows-1252"?>
<string_table>
  <string id="ui_mcm_ssfx_module_motionblur_title">
    <text>Desfoque de movimento - Configurações</text>
  </string>
  <string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_camera_mcm">
    <text>Intensidade do movimento da câmera</text>
  </string>
  <string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_camera_mcm_desc">
    <text>Ajusta ou desativa completamente o desfoque causado pelo movimento da câmera.</text>
  </string>
  <string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_hudonly_mcm">
    <text>Somente HUD</text>
  </string>
  <string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_hudonly_mcm_desc">
    <text>Aplica o desfoque somente aos elementos do HUD (mãos, armas etc.).</text>
  </string>
  <string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_intensity_mcm">
    <text>Intensidade geral</text>
  </string>
  <string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_intensity_mcm_desc">
    <text>Define a intensidade do desfoque de movimento. Use 0 para desativá-lo.</text>
  </string>
  <string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_quality_mcm">
    <text>Qualidade</text>
  </string>
  <string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_quality_mcm_desc">
    <text>Define a quantidade de amostras usadas no desfoque de movimento. [ 4 - 6 - 8 - 12 ]</text>
  </string>
</string_table>
