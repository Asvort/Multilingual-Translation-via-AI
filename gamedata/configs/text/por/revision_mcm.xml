  <string id="ui_mcm_lst_VDT">
    <text>Cálculo do limite de distância visível</text>
  </string>
  <string id="ui_mcm_menu_revision">
    <text>RE:VISION</text>
  </string>
  <string id="ui_mcm_revision_agressive_response">
    <text>Resposta agressiva</text>
  </string>
  <string id="ui_mcm_revision_agressive_response_desc">
    <text>Atirar em NPCs além do limite de distância visível fará com que reajam de forma agressiva.</text>
  </string>
  <string id="ui_mcm_revision_bright_area_nerf_strength">
    <text>Intensidade do ajuste de áreas claras</text>
  </string>
  <string id="ui_mcm_revision_bright_area_nerf_strength_desc">
    <text>Aumenta ou reduz a influência de ambientes muito claros na visibilidade para evitar superexposição na visão da IA. Use para ajustar o RE:Tinal ao seu sistema climático.</text>
  </string>
  <string id="ui_mcm_revision_campfire_influence_distance">
    <text>Distância de influência da fogueira</text>
  </string>
  <string id="ui_mcm_revision_campfire_influence_distance_desc">
    <text>Define até que distância fogueiras e fontes de luz semelhantes iluminam as zonas de percepção dos NPCs.</text>
  </string>
  <string id="ui_mcm_revision_crouch_visibility_multiplier">
    <text>Multiplicador de visibilidade ao agachar</text>
  </string>
  <string id="ui_mcm_revision_crouch_visibility_multiplier_desc">
    <text>Ajusta quanto sua visibilidade diminui ao agachar. Valores menores melhoram a camuflagem.</text>
  </string>
  <string id="ui_mcm_revision_dark_area_boost_strength">
    <text>Intensidade do ajuste de áreas escuras</text>
  </string>
  <string id="ui_mcm_revision_dark_area_boost_strength_desc">
    <text>Aumenta ou reduz a visibilidade em áreas escuras para que os NPCs não fiquem totalmente cegos. Ajuste o RE:Tinal ao sistema climático.</text>
  </string>
  <string id="ui_mcm_revision_debug_type">
    <text>Tipo de depuração</text>
  </string>
  <string id="ui_mcm_revision_debug_type_desc">
    <text>Escolha entre o cálculo de VDT e o cálculo de luminosidade.</text>
  </string>
  <string id="ui_mcm_revision_detection_range">
    <text>Alcance de detecção</text>
  </string>
  <string id="ui_mcm_revision_detection_range_desc">
    <text>Define a distância máxima em que os NPCs podem detectar ou ver o jogador e outros NPCs.</text>
  </string>
  <string id="ui_mcm_revision_enable_debug">
    <text>Ativar depuração</text>
  </string>
  <string id="ui_mcm_revision_enable_debug_desc">
    <text>Exibe registros na tela e mensagens do console para testar a visibilidade e depurar as respostas do sistema.</text>
  </string>
  <string id="ui_mcm_revision_fov_central_vision_angle">
    <text>Ângulo de visão central dos NPCs</text>
  </string>
  <string id="ui_mcm_revision_fov_central_vision_angle_desc">
    <text>Ajusta a largura do campo de visão central dos NPCs. Dentro desse ângulo, eles percebem tudo plenamente.</text>
  </string>
  <string id="ui_mcm_revision_fov_peripheral_vision_angle">
    <text>Ângulo de visão periférica dos NPCs</text>
  </string>
  <string id="ui_mcm_revision_fov_peripheral_vision_angle_desc">
    <text>Ajusta a largura do campo de visão periférica dos NPCs. Nela, a percepção é menor; a luminosidade também influencia.</text>
  </string>
  <string id="ui_mcm_revision_global_luminance_multiplier">
    <text>Multiplicador global de luminância</text>
  </string>
  <string id="ui_mcm_revision_global_luminance_multiplier_desc">
    <text>Ajusta a sensibilidade geral da visão dos NPCs à luminosidade. Valores maiores fazem o mundo parecer mais claro para a IA. Use para calibrar o RE:Tinal ao seu sistema climático.</text>
  </string>
  <string id="ui_mcm_revision_indoor_check_frequency">
    <text>Frequência de verificação em interiores</text>
  </string>
  <string id="ui_mcm_revision_indoor_check_frequency_desc">
    <text>Define a frequência com que o script verifica se o personagem está dentro ou fora. Usa traçado de raios.</text>
  </string>
