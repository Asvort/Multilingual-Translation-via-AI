<?xml version="1.0" encoding="windows-1252"?>
<string_table>
  <string id="ui_mcm_ssfx_module_terrain">
    <text>Gelände</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_distance_mcm">
    <text>Darstellungsqualität</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_distance_mcm_desc">
    <text>Passt die maximale Entfernung für die hochwertige Geländedarstellung an.</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_grass_align_mcm">
    <text>Gras an Gelände ausrichten (Kartenneuladen erforderlich)</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_grass_align_mcm_desc">
    <text>Richtet Gras an der Geländeneigung aus.</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_grass_slope_mcm">
    <text>Grasneigungsgrenze (Kartenneuladen erforderlich)</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_grass_slope_mcm_desc">
    <text>Begrenzt die Grasplatzierung, wenn die Geländeneigung den gewählten Winkel überschreitet.</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_height_mcm">
    <text>Parallax-Höhe</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_height_mcm_desc">
    <text>Passt die maximale Höhe des Parallax-Effekts an.</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_quality_mcm">
    <text>Parallax-Qualität</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_quality_mcm_desc">
    <text>Legt die visuelle Qualität des Effekts fest. Höhere Werte verwenden mehr Abtastungen für ein glatteres Ergebnis.</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_range_mcm">
    <text>Parallax-Reichweite</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_range_mcm_desc">
    <text>Legt die maximale Darstellungsreichweite des Parallax-Effekts fest.</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_refine_mcm">
    <text>Parallax-Verfeinerung</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_refine_mcm_desc">
    <text>Fügt einen Verfeinerungsschritt hinzu. Aktiviere oder deaktiviere ihn, um die Bildqualität oder Leistung zu verbessern.</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_water_level_mcm">
    <text>Parallax-Wasserstand</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_pom_water_level_mcm_desc">
    <text>Passt die maximale Tiefe von Pfützen an.</text>
  </string>
  <string id="ui_mcm_ssfx_module_terrain_title">
    <text>Geländeeinstellungen</text>
  </string>
</string_table>
