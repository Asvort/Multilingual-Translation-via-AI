  <string id="ui_mcm_menu_revision">
    <text>RE:VISION</text>
  </string>
  <string id="ui_mcm_revision_agressive_response">
    <text>Aggressive Reaktion</text>
  </string>
  <string id="ui_mcm_revision_agressive_response_desc">
    <text>Wenn du NPCs außerhalb der Sichtweitenschwelle beschießt, reagieren sie aggressiv.</text>
  </string>
  <string id="ui_mcm_revision_bright_area_nerf_strength">
    <text>Stärke der Anpassung heller Bereiche</text>
  </string>
  <string id="ui_mcm_revision_bright_area_nerf_strength_desc">
    <text>Verstärkt oder verringert den Einfluss sehr heller Umgebungen auf die Sichtbarkeit, um Überbelichtung der KI-Sicht zu vermeiden. Stimme RE:Tinal damit auf dein Wettersystem ab.</text>
  </string>
  <string id="ui_mcm_revision_campfire_influence_distance">
    <text>Einflussreichweite des Lagerfeuers</text>
  </string>
  <string id="ui_mcm_revision_campfire_influence_distance_desc">
    <text>Legt fest, aus welcher Entfernung Lagerfeuer und ähnliche Lichtquellen die Wahrnehmungsbereiche von NPCs beleuchten.</text>
  </string>
  <string id="ui_mcm_revision_crouch_visibility_multiplier">
    <text>Sichtbarkeitsmultiplikator beim Ducken</text>
  </string>
  <string id="ui_mcm_revision_crouch_visibility_multiplier_desc">
    <text>Legt fest, wie stark Ducken die Sichtbarkeit verringert. Niedrigere Werte verbessern die Tarnung.</text>
  </string>
  <string id="ui_mcm_revision_dark_area_boost_strength">
    <text>Stärke der Anpassung dunkler Bereiche</text>
  </string>
  <string id="ui_mcm_revision_dark_area_boost_strength_desc">
    <text>Verstärkt oder verringert die Sichtbarkeit in dunklen Bereichen, damit NPCs bei nahezu völliger Dunkelheit nicht blind sind. Stimme RE:Tinal auf dein Wettersystem ab.</text>
  </string>
  <string id="ui_mcm_revision_debug_type">
    <text>Debug-Typ</text>
  </string>
  <string id="ui_mcm_revision_debug_type_desc">
    <text>Wähle zwischen VDT- und Helligkeitsberechnung.</text>
  </string>
  <string id="ui_mcm_revision_detection_range">
    <text>Erkennungsreichweite</text>
  </string>
  <string id="ui_mcm_revision_detection_range_desc">
    <text>Legt die maximale Entfernung fest, aus der NPCs den Spieler und andere NPCs erkennen können.</text>
  </string>
  <string id="ui_mcm_revision_enable_debug">
    <text>Debug aktivieren</text>
  </string>
  <string id="ui_mcm_revision_enable_debug_desc">
    <text>Zeigt Bildschirmprotokolle und Konsolenmeldungen zum Testen des Sichtverhaltens und zur Fehlersuche an.</text>
  </string>
  <string id="ui_mcm_revision_fov_central_vision_angle">
    <text>Zentraler Sichtwinkel der NPCs</text>
  </string>
  <string id="ui_mcm_revision_fov_central_vision_angle_desc">
    <text>Legt die Breite des zentralen Sichtfelds von NPCs fest. Innerhalb dieses Winkels nehmen sie Ziele vollständig wahr.</text>
  </string>
  <string id="ui_mcm_revision_fov_peripheral_vision_angle">
    <text>Peripherer Sichtwinkel von NPCs</text>
  </string>
  <string id="ui_mcm_revision_fov_peripheral_vision_angle_desc">
    <text>Legt die Breite des peripheren Sichtfelds von NPCs fest. Dort ist ihre Wahrnehmung geringer und wird auch von der Helligkeit beeinflusst.</text>
  </string>
  <string id="ui_mcm_revision_global_luminance_multiplier">
    <text>Globaler Helligkeitsmultiplikator</text>
  </string>
  <string id="ui_mcm_revision_global_luminance_multiplier_desc">
    <text>Legt die allgemeine Helligkeitsempfindlichkeit der NPC-Sicht fest. Höhere Werte lassen die Welt für die KI heller erscheinen. Damit RE:Tinal an das Wettersystem anpassen.</text>
  </string>
  <string id="ui_mcm_revision_indoor_check_frequency">
    <text>Häufigkeit der Innenraumprüfung</text>
  </string>
  <string id="ui_mcm_revision_indoor_check_frequency_desc">
    <text>Legt fest, wie oft das Skript prüft, ob sich die Figur drinnen oder draußen befindet. Verwendet Raycasting.</text>
  </string>
  <string id="ui_mcm_revision_key_0">
    <text>Mitternacht (00:00)</text>
  </string>
  <string id="ui_mcm_revision_key_0_desc">
    <text>Ermöglicht, die Helligkeit für jeden wichtigen Zeitpunkt des Hauptprofils festzulegen.</text>
  </string>
