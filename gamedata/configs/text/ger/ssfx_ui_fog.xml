<?xml version="1.0" encoding="windows-1252"?>
<string_table>
  <string id="ui_mcm_ssfx_module_fog">
    <text>Nebel</text>
  </string>
  <string id="ui_mcm_ssfx_module_fog_density_mcm">
    <text>Dichte</text>
  </string>
  <string id="ui_mcm_ssfx_module_fog_density_mcm_desc">
    <text>Steuert die Gesamtdichte des Höhennebels. Der Grundwert wird weiterhin durch die Wettervorgaben bestimmt.</text>
  </string>
  <string id="ui_mcm_ssfx_module_fog_height_mcm">
    <text>Höhe</text>
  </string>
  <string id="ui_mcm_ssfx_module_fog_height_mcm_desc">
    <text>Passt die Höhe des Nebels an. Je höher der Wert, desto weicher wirkt der Nebel.</text>
  </string>
  <string id="ui_mcm_ssfx_module_fog_scattering_mcm">
    <text>Nebelstreuung</text>
  </string>
  <string id="ui_mcm_ssfx_module_fog_scattering_mcm_desc">
    <text>Stärke des Nebelstreuungseffekts. Dadurch wirkt der Nebel dichter.</text>
  </string>
  <string id="ui_mcm_ssfx_module_fog_suncolor_mcm">
    <text>Sonnentönung</text>
  </string>
  <string id="ui_mcm_ssfx_module_fog_suncolor_mcm_desc">
    <text>Legt fest, wie stark die Sonnenfarbe den Nebel einfärbt.</text>
  </string>
  <string id="ui_mcm_ssfx_module_fog_title">
    <text>Nebeleinstellungen</text>
  </string>
</string_table>
