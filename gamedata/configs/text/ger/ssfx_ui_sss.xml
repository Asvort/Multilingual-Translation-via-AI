<?xml version="1.0" encoding="windows-1252"?>
<string_table>
  <string id="ui_mcm_ssfx_module_sss">
    <text>SSS</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_enable_dir_mcm">
    <text>Schatten gerichteter Lichtquellen aktivieren</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_enable_dir_mcm_desc">
    <text>Aktiviert oder deaktiviert Bildschirmraum-Schatten für gerichtete Lichtquellen (Sonne und Mond).</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_enable_point_mcm">
    <text>Schatten omnidirektionaler Lichtquellen aktivieren</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_enable_point_mcm_desc">
    <text>Aktiviert oder deaktiviert Bildschirmraum-Schatten für omnidirektionale Lichtquellen (Glühbirnen, Lagerfeuer usw.).</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_len_dir_mcm">
    <text>Länge gerichteter Lichtschatten</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_len_dir_mcm_desc">
    <text>Passt die maximale Länge gerichteter Schatten an.</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_len_point_mcm">
    <text>Länge omnidirektionaler Lichtschatten</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_len_point_mcm_desc">
    <text>Passt die maximale Länge aller omnidirektionalen Schatten an.</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_quality_dir_mcm">
    <text>Qualität gerichteter Lichtquellen</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_quality_dir_mcm_desc">
    <text>Anzahl der Abtastungen für Schatten gerichteter Lichtquellen (Sonne und Mond). Mehr Abtastungen verbessern die Kontur. [ 6 - 12 - 18 - 24 ]</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_quality_point_mcm">
    <text>Qualität omnidirektionaler Lichtquellen</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_quality_point_mcm_desc">
    <text>Anzahl der Abtastungen für Schatten omnidirektionaler Lichtquellen (Glühbirnen, Lagerfeuer usw.). Mehr Abtastungen verbessern die Kontur. [ 2 - 4 - 6 - 8 ]</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_title">
    <text>Einstellungen für Bildschirmraum-Schatten</text>
  </string>
</string_table>
