<?xml version="1.0" encoding="windows-1252"?>
<string_table>
  <string id="ui_mcm_ssfx_module_motionblur_title">
    <text>Bewegungsunschärfe - Einstellungen</text>
  </string>
  <string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_camera_mcm">
    <text>Kamerabewegungsintensität</text>
  </string>
  <string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_camera_mcm_desc">
    <text>Passt die durch Kamerabewegung verursachte Unschärfe an oder deaktiviert sie vollständig.</text>
  </string>
  <string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_hudonly_mcm">
    <text>Nur HUD</text>
  </string>
  <string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_hudonly_mcm_desc">
    <text>Bewegungsunschärfe nur auf HUD-Elemente anwenden (Hände, Waffen usw.).</text>
  </string>
  <string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_intensity_mcm">
    <text>Gesamtintensität</text>
  </string>
  <string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_intensity_mcm_desc">
    <text>Legt die Stärke der Bewegungsunschärfe fest. Bei 0 ist der Effekt deaktiviert.</text>
  </string>
  <string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_quality_mcm">
    <text>Qualität</text>
  </string>
  <string id="ui_mcm_ssfx_module_ssfx_pp_ssfx_motionblur_quality_mcm_desc">
    <text>Legt die Anzahl der Abtastungen für Bewegungsunschärfe fest. [ 4 - 6 - 8 - 12 ]</text>
  </string>
</string_table>
