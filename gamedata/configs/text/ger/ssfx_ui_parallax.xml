<?xml version="1.0" encoding="windows-1252"?>
<string_table>
  <string id="ui_mcm_ssfx_module_parallax">
    <text>Parallaxe</text>
  </string>
  <string id="ui_mcm_ssfx_module_parallax_ao_mcm">
    <text>Parallax-Umgebungsverdeckung</text>
  </string>
  <string id="ui_mcm_ssfx_module_parallax_ao_mcm_desc">
    <text>Legt die zusätzliche Umgebungsverdeckung auf Parallax-Oberflächen fest.</text>
  </string>
  <string id="ui_mcm_ssfx_module_parallax_height_mcm">
    <text>Parallax-Höhe</text>
  </string>
  <string id="ui_mcm_ssfx_module_parallax_height_mcm_desc">
    <text>Passt die maximale Höhe des Parallax-Effekts an.</text>
  </string>
  <string id="ui_mcm_ssfx_module_parallax_quality_mcm">
    <text>Parallax-Qualität</text>
  </string>
  <string id="ui_mcm_ssfx_module_parallax_quality_mcm_desc">
    <text>Legt die visuelle Qualität des Effekts fest. Höhere Werte verwenden mehr Abtastungen für ein glatteres Ergebnis.</text>
  </string>
  <string id="ui_mcm_ssfx_module_parallax_range_mcm">
    <text>Parallax-Reichweite</text>
  </string>
  <string id="ui_mcm_ssfx_module_parallax_range_mcm_desc">
    <text>Legt die maximale Darstellungsreichweite des Parallax-Effekts fest.</text>
  </string>
  <string id="ui_mcm_ssfx_module_parallax_refine_mcm">
    <text>Parallax-Verfeinerung</text>
  </string>
  <string id="ui_mcm_ssfx_module_parallax_refine_mcm_desc">
    <text>Fügt einen Verfeinerungsschritt hinzu. Aktiviere oder deaktiviere ihn, um die Bildqualität oder Leistung zu verbessern.</text>
  </string>
  <string id="ui_mcm_ssfx_module_parallax_title">
    <text>Geländeeinstellungen</text>
  </string>
</string_table>
