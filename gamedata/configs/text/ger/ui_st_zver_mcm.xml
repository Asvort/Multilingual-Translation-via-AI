<?xml version="1.0" encoding="windows-1252"?>
<string_table>
  <string id="ui_mcm_menu_zver">
    <text>Zver HUD Compact</text>
  </string>
  <string id="ui_mcm_zver_ammoshow">
    <text>Gesamtmunitionszähler</text>
  </string>
  <string id="ui_mcm_zver_ammoshow_desc">
    <text>Zeigt die GESAMTMENGE an Munition für jeden der 3 im Inventar verfügbaren Typen.</text>
  </string>
  <string id="ui_mcm_zver_armorbar">
    <text>Rüstungszustandsleiste</text>
  </string>
  <string id="ui_mcm_zver_armorbar_desc">
    <text>Zeigt die Rüstungszustandsleiste an.</text>
  </string>
  <string id="ui_mcm_zver_armortext">
    <text>Rüstungszustand als %-Text</text>
  </string>
  <string id="ui_mcm_zver_armortext_desc">
    <text>Zeigt den Rüstungszustand als Prozentwert im Text an. \n%c[ui_gray_2]Ohne Wirkung, wenn die Leiste deaktiviert ist.</text>
  </string>
  <string id="ui_mcm_zver_bleedingbarshow">
    <text>Blutungsleiste</text>
  </string>
  <string id="ui_mcm_zver_bleedingbarshow_desc">
    <text>Zeigt den Blutverlust als Leiste an.</text>
  </string>
  <string id="ui_mcm_zver_healingbar">
    <text>Gesundheitsprognose-Leiste</text>
  </string>
  <string id="ui_mcm_zver_healingbar_desc">
    <text>Zeigt die wiederhergestellte Gesundheit in 10-Punkte-Schritten an.</text>
  </string>
  <string id="ui_mcm_zver_oldammoshow">
    <text>Alte Munition</text>
  </string>
  <string id="ui_mcm_zver_oldammoshow_desc">
    <text>Zeigt alte Munition bei Bedarf an, etwa wenn keine guten Gegenstücke vorhanden sind.</text>
  </string>
  <string id="ui_mcm_zver_radhealthshow">
    <text>Strahlenbelastungsleiste</text>
  </string>
  <string id="ui_mcm_zver_radhealthshow_desc">
    <text>Zeigt die Strahlenbelastung als Leiste an.</text>
  </string>
  <string id="ui_mcm_zver_weaponbarhide">
    <text>HUD beim Wegstecken ausblenden</text>
  </string>
  <string id="ui_mcm_zver_weaponbarhide_desc">
    <text>Blendet die Waffenzustandsleiste aus, wenn die Waffe weggesteckt wird. \n%c[ui_gray_2]Ohne Wirkung, wenn die Leiste deaktiviert ist.</text>
  </string>
  <string id="ui_mcm_zver_weaponshow">
    <text>Waffenzustandsleiste</text>
  </string>
  <string id="ui_mcm_zver_weaponshow_desc">
    <text>Zeigt die Waffenzustandsleiste an.</text>
  </string>
  <string id="ui_mcm_zver_weapontext">
    <text>Waffenzustand als %-Text</text>
  </string>
  <string id="ui_mcm_zver_weapontext_desc">
    <text>Zeigt den Waffenzustand als Prozentwert im Text an. \n%c[ui_gray_2]Ohne Wirkung, wenn die Leiste deaktiviert ist.</text>
  </string>
  <string id="ui_mm_video_hud_zverslide">
    <text>Zver HUD Compact - Einstellungen</text>
  </string>
</string_table>
