<?xml version="1.0" encoding="windows-1252"?>
<string_table>
  <string id="ui_mcm_ssfx_module_inter_grass">
    <text>Interaktives Gras</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_anomalies_distance_mcm">
    <text>Maximale Interaktionsentfernung für Anomalien</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_anomalies_distance_mcm_desc">
    <text>Legt die maximale Entfernung fest, bis zu der Interaktionen zwischen Anomalien und Gras dargestellt werden.</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_enable_anomalies_mcm">
    <text>Interaktion mit Anomalien</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_enable_anomalies_mcm_desc">
    <text>Aktiviert oder deaktiviert die Interaktion zwischen Gras und Anomalien.</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_enable_mcm">
    <text>Aktiviert</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_enable_mcm_desc">
    <text>[ RESTART REQUIERED ] Aktiviert oder deaktiviert die Interaktion mit Gras.</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_enable_mutants_mcm">
    <text>Schockwelle von Mutanten</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_enable_mutants_mcm_desc">
    <text>Aktiviert oder deaktiviert die Schockwellen von Pseudogiganten und Burer.</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_enable_player_mcm">
    <text>Interaktion mit dem Spieler</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_enable_player_mcm_desc">
    <text>Aktiviert oder deaktiviert die Interaktion des Spielers mit Gras.</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_explosions_speed_mcm">
    <text>Ausbreitungsgeschwindigkeit</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_explosions_speed_mcm_desc">
    <text>Legt die Ausbreitungsgeschwindigkeit der Schockwelle fest.</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_explosions_str_mcm">
    <text>Explosionsintensität</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_explosions_str_mcm_desc">
    <text>Legt die Gesamtintensität der Schockwelle fest.</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_horizontal_str_mcm">
    <text>Horizontale Stärke</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_horizontal_str_mcm_desc">
    <text>Legt die Stärke der horizontalen Grasbewegung fest, wenn Figuren hindurchlaufen.</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_max_distance_mcm">
    <text>Maximale Entfernung</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_max_distance_mcm_desc">
    <text>Maximale Entfernung, bis zu der Grasinteraktionen dargestellt werden.</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_max_entities_mcm">
    <text>Maximale Anzahl gleichzeitiger Interaktionen</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_max_entities_mcm_desc">
    <text>[ RESTART REQUIERED ] Maximale Anzahl gleichzeitiger Interaktionen. Höhere Werte können die Leistung beeinträchtigen.</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_radius_mcm">
    <text>Biegeradius</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_radius_mcm_desc">
    <text>Legt den Biegeradius des Grases fest, wenn Figuren hindurchlaufen.</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_shooting_range_mcm">
    <text>Reichweite der Schüsse</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_shooting_range_mcm_desc">
    <text>Reichweite der Grasbewegung durch Schüsse.</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_shooting_str_mcm">
    <text>Stärke der Schüsse</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_shooting_str_mcm_desc">
    <text>Stärke der Grasbewegung durch Schüsse aus Feuerwaffen.</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_title">
    <text>Einstellungen für interaktives Gras</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_vertical_str_mcm">
    <text>Vertikale Stärke</text>
  </string>
  <string id="ui_mcm_ssfx_module_inter_grass_vertical_str_mcm_desc">
    <text>Legt die Stärke der vertikalen Grasbewegung fest, wenn Figuren hindurchlaufen.</text>
  </string>
</string_table>
