<?xml version="1.0" encoding="windows-1252"?>
<string_table>
  <string id="exchanging_items_phr_0">
    <text>Hey, Kumpel, mal sehen, wer mehr Zeug hat.</text>
  </string>
  <string id="exchanging_items_phr_1">
    <text>Ja, warum tauschen wir nicht? Das kann ich anbieten.</text>
  </string>
  <string id="exchanging_items_phr_10">
    <text>Wie du willst.</text>
  </string>
  <string id="exchanging_items_phr_2">
    <text>Ich nehme das Artefakt...</text>
  </string>
  <string id="exchanging_items_phr_3">
    <text>Ich nehme den Anzug...</text>
  </string>
  <string id="exchanging_items_phr_4">
    <text>Ich nehme den Gegenstand...</text>
  </string>
  <string id="exchanging_items_phr_5">
    <text>Ich nehme die Waffe...</text>
  </string>
  <string id="exchanging_items_phr_6">
    <text>Gut. Dafür nehme ich das hier.</text>
  </string>
  <string id="exchanging_items_phr_7">
    <text>Ich glaube nicht, dass wir viel zu besprechen haben, da du nichts hast, was sich für mich lohnt. Komm wieder, wenn du mehr Geld hast.</text>
  </string>
  <string id="exchanging_items_phr_8">
    <text>In Ordnung, tauschen wir.</text>
  </string>
  <string id="exchanging_items_phr_9">
    <text>Ich habe es mir mit dem Tausch anders überlegt.</text>
  </string>
</string_table>
