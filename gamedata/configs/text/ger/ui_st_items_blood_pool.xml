  </string>
  <string id="ui_mcm_blood_pool_num_of_updates_desc">
    <text>Mehr Aktualisierungen sorgen für einen gleichmäßigeren Größenanstieg (die Maximalgröße bleibt unverändert).</text>
  </string>
  <string id="ui_mcm_blood_pool_pool_lifetime">
