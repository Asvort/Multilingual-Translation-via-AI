  <string id="ui_mcm_ssfx_module_shadows">
    <text>Schatten und Beleuchtung</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_lod_max_mcm">
    <text>Maximale Schattenauflösung</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_lod_max_mcm_desc">
    <text>Maximale Auflösung der Schattenkarte. Sind Lichtquellen näher, steigt die Auflösung zugunsten der Schattenqualität auf Kosten der Leistung.</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_lod_min_mcm">
    <text>Minimale Schattenauflösung</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_lod_min_mcm_desc">
    <text>Minimale Auflösung der Schattenkarte. Sind Lichtquellen weit vom Spieler entfernt, sinkt die Schattenauflösung zugunsten der Leistung auf Kosten der Bildqualität.</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_lod_quality_mcm">
    <text>Schatten-LOD</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_lod_quality_mcm_desc">
    <text>Grundqualität der Schattenkarte. Ein höherer Wert erhöht die Basisauflösung der Schatten und ihre Auflösung in der Entfernung.</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_title">
    <text>Einstellungen für Schatten und Beleuchtung</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_volumetric_force_mcm">
    <text>Volumetrische Beleuchtung erzwingen ( Karte muss neu geladen werden )</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_volumetric_force_mcm_desc">
    <text>Erzwingt den volumetrischen Effekt für alle ungerichteten Lichtquellen. Lade die Karte neu, um die Einstellung anzuwenden.</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_volumetric_int_mcm">
    <text>Intensität der volumetrischen Beleuchtung</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_volumetric_int_mcm_desc">
    <text>Legt die Intensität des volumetrischen Effekts fest.</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_volumetric_quality_mcm">
    <text>Qualität der volumetrischen Beleuchtung</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_volumetric_quality_mcm_desc">
    <text>Legt die Qualität des volumetrischen Effekts auf Kosten der Leistung fest.</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_volumetric_resolution_mcm">
    <text>Auflösung der volumetrischen Beleuchtung</text>
  </string>
  <string id="ui_mcm_ssfx_module_shadows_volumetric_resolution_mcm_desc">
    <text>Renderauflösung der volumetrischen Beleuchtung als Anteil der aktuellen Auflösung. [ min: 14% ~ max: 100% ]</text>
  </string>
</string_table>
