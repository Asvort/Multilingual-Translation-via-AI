    <text>Alternative Kantenerkennung</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_alternativeClimbDetection_desc">
    <text>Die alternative Methode sucht näher am Fadenkreuz nach Kanten. Die Standardmethode scannt aus einer festen Höhe.</text>
  </string>
  <string id="ui_mcm_demonized_ledge_grabbing_animationRandomization">
