  <string id="ui_mcm_advanced_stamina_system_enable_sleep_drain">
    <text>Ausdauerverbrauch und -bonus durch Schlaf aktivieren</text>
  </string>
  <string id="ui_mcm_advanced_stamina_system_enable_sleep_drain_desc">
    <text>Ohne Schlaf erhältst du einen Ausdauerbonus, der mit zunehmender Müdigkeit linear sinkt. Ab dem grauen Symbol erhältst du einen Malus.</text>
  </string>
  <string id="ui_mcm_advanced_stamina_system_enable_stamina_speed_modifier">
