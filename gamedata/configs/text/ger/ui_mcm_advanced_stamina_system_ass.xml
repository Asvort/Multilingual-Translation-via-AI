  <string id="ui_mcm_advanced_stamina_system_enable_thirst_drain_desc">
    <text>Ohne Durst erhältst du einen Ausdauerbonus, der mit zunehmendem Durst linear sinkt. Ab dem grauen Symbol erhältst du einen Malus.</text>
  </string>
  <string id="ui_mcm_advanced_stamina_system_enable_uphill_drain">
