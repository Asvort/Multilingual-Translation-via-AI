<?xml version="1.0" encoding="windows-1251"?>
<string_table>
  <string id="ui_mcm_menu_zver">
    <text>Zver HUD Compact</text>
  </string>
  <string id="ui_mcm_zver_ammoshow">
    <text>Лічильники загальної кількості набоїв</text>
  </string>
  <string id="ui_mcm_zver_ammoshow_desc">
    <text>Показує ЗАГАЛЬНУ кількість набоїв трьох типів, що є в інвентарі.</text>
  </string>
  <string id="ui_mcm_zver_armorbar">
    <text>Шкала стану броні</text>
  </string>
  <string id="ui_mcm_zver_armorbar_desc">
    <text>Показує шкалу стану броні.</text>
  </string>
  <string id="ui_mcm_zver_armortext">
    <text>Стан броні у %-тексті</text>
  </string>
  <string id="ui_mcm_zver_armortext_desc">
    <text>Показує стан броні у відсотках текстом. \n%c[ui_gray_2]Не діє, якщо шкалу вимкнено.</text>
  </string>
  <string id="ui_mcm_zver_bleedingbarshow">
    <text>Шкала кровотечі</text>
  </string>
  <string id="ui_mcm_zver_bleedingbarshow_desc">
    <text>Показує обсяг втрати крові у вигляді шкали.</text>
  </string>
  <string id="ui_mcm_zver_healingbar">
    <text>Шкала прогнозу здоров’я</text>
  </string>
  <string id="ui_mcm_zver_healingbar_desc">
    <text>Показує кількість відновлюваного здоров’я поділками по 10 одиниць.</text>
  </string>
  <string id="ui_mcm_zver_oldammoshow">
    <text>Старі набої</text>
  </string>
  <string id="ui_mcm_zver_oldammoshow_desc">
    <text>Показує старі набої за потреби, наприклад, якщо в інвентарі немає їхніх якісних аналогів.</text>
  </string>
  <string id="ui_mcm_zver_radhealthshow">
    <text>Шкала опромінення</text>
  </string>
  <string id="ui_mcm_zver_radhealthshow_desc">
    <text>Показує рівень отриманого опромінення у вигляді шкали.</text>
  </string>
  <string id="ui_mcm_zver_weaponbarhide">
    <text>Ховати HUD, коли зброю прибрано</text>
  </string>
  <string id="ui_mcm_zver_weaponbarhide_desc">
    <text>Ховає шкалу стану зброї, коли її прибрано. \n%c[ui_gray_2]Не діє, якщо шкалу вимкнено.</text>
  </string>
  <string id="ui_mcm_zver_weaponshow">
    <text>Шкала стану зброї</text>
  </string>
  <string id="ui_mcm_zver_weaponshow_desc">
    <text>Показує шкалу стану зброї.</text>
  </string>
  <string id="ui_mcm_zver_weapontext">
    <text>Стан зброї у %-тексті</text>
  </string>
  <string id="ui_mcm_zver_weapontext_desc">
    <text>Показує стан зброї у відсотках текстом. \n%c[ui_gray_2]Не діє, якщо шкалу вимкнено.</text>
  </string>
  <string id="ui_mm_video_hud_zverslide">
    <text>Zver HUD Compact — налаштування</text>
  </string>
</string_table>
