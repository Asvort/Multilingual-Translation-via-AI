<?xml version="1.0" encoding="windows-1251"?>
<string_table>
  <string id="st_lab_tier_actor_msg_1">
    <text>Повітря здається важчим</text>
  </string>
  <string id="st_lab_tier_actor_msg_10">
    <text>Раптовий різкий холод</text>
  </string>
  <string id="st_lab_tier_actor_msg_11">
    <text>Мені страшно</text>
  </string>
  <string id="st_lab_tier_actor_msg_12">
    <text>Тиша стає ворожою</text>
  </string>
  <string id="st_lab_tier_actor_msg_13">
    <text>На мене хтось дивиться</text>
  </string>
  <string id="st_lab_tier_actor_msg_14">
    <text>Далі коридором чути хлюпання</text>
  </string>
  <string id="st_lab_tier_actor_msg_15">
    <text>Тут надто небезпечно</text>
  </string>
  <string id="st_lab_tier_actor_msg_16">
    <text>У мене спітніли долоні</text>
  </string>
  <string id="st_lab_tier_actor_msg_17">
    <text>Пахне кров’ю та порохом</text>
  </string>
  <string id="st_lab_tier_actor_msg_18">
    <text>У горлі застряг клубок</text>
  </string>
  <string id="st_lab_tier_actor_msg_19">
    <text>Моє серце закалатало</text>
  </string>
  <string id="st_lab_tier_actor_msg_2">
    <text>Тут надто темно</text>
  </string>
  <string id="st_lab_tier_actor_msg_20">
    <text>Дивні спазми м’язів</text>
  </string>
  <string id="st_lab_tier_actor_msg_21">
    <text>Я не чую, як дихаю</text>
  </string>
  <string id="st_lab_tier_actor_msg_22">
    <text>Я бачу червоні плями</text>
  </string>
  <string id="st_lab_tier_actor_msg_23">
    <text>Нутром чую, що тут щось лихе</text>
  </string>
  <string id="st_lab_tier_actor_msg_24">
    <text>Крапля поту скотилася чолом</text>
  </string>
  <string id="st_lab_tier_actor_msg_25">
    <text>Далі коридором чути гарчання</text>
  </string>
  <string id="st_lab_tier_actor_msg_26">
    <text>Гнітюча тиша збиває з пантелику</text>
  </string>
  <string id="st_lab_tier_actor_msg_27">
    <text>Я чую запах смерті</text>
  </string>
  <string id="st_lab_tier_actor_msg_28">
    <text>Мої руки заніміли</text>
  </string>
  <string id="st_lab_tier_actor_msg_29">
    <text>У скронях застукотіло</text>
  </string>
  <string id="st_lab_tier_actor_msg_3">
    <text>Я тут не один</text>
  </string>
  <string id="st_lab_tier_actor_msg_30">
    <text>Я не збираюся тут здохнути</text>
  </string>
  <string id="st_lab_tier_actor_msg_31">
    <text>Я бачив, як попереду щось промайнуло</text>
  </string>
  <string id="st_lab_tier_actor_msg_32">
    <text>Я більше не хочу тут бути</text>
  </string>
  <string id="st_lab_tier_actor_msg_33">
    <text>Я чую чиїсь кроки</text>
  </string>
  <string id="st_lab_tier_actor_msg_34">
    <text>Мені важко дихати</text>
  </string>
  <string id="st_lab_tier_actor_msg_35">
    <text>На мене хтось дивиться</text>
  </string>
  <string id="st_lab_tier_actor_msg_36">
    <text>Стіни насуваються на мене</text>
  </string>
  <string id="st_lab_tier_actor_msg_37">
    <text>Мою свідомість огорнула пелена страху</text>
  </string>
  <string id="st_lab_tier_actor_msg_38">
    <text>Інстинкти кажуть тікати</text>
  </string>
  <string id="st_lab_tier_actor_msg_39">
    <text>Крижаний холод поповз спиною</text>
  </string>
  <string id="st_lab_tier_actor_msg_4">
    <text>Я чув скрип дверей</text>
  </string>
  <string id="st_lab_tier_actor_msg_40">
    <text>Зір загострився до межі</text>
  </string>
  <string id="st_lab_tier_actor_msg_41">
    <text>Я чую якийсь гул</text>
  </string>
  <string id="st_lab_tier_actor_msg_42">
    <text>Простір спотворився</text>
  </string>
  <string id="st_lab_tier_actor_msg_43">
    <text>За мною хтось стежить</text>
  </string>
  <string id="st_lab_tier_actor_msg_44">
    <text>Я чую якесь клацання</text>
  </string>
  <string id="st_lab_tier_actor_msg_45">
    <text>Пахне озоном</text>
  </string>
  <string id="st_lab_tier_actor_msg_46">
    <text>Серце завмерло</text>
  </string>
  <string id="st_lab_tier_actor_msg_47">
    <text>Моє тіло напружилося, мов струна</text>
  </string>
  <string id="st_lab_tier_actor_msg_48">
    <text>Нутро опирається</text>
  </string>
  <string id="st_lab_tier_actor_msg_49">
    <text>Тисячі голок вп’ялися в спину</text>
  </string>
  <string id="st_lab_tier_actor_msg_5">
    <text>Мені не по собі</text>
  </string>
  <string id="st_lab_tier_actor_msg_50">
    <text>Усередині все стиснулося в німому крику</text>
  </string>
  <string id="st_lab_tier_actor_msg_51">
    <text>Я не відчуваю ваги зброї</text>
  </string>
  <string id="st_lab_tier_actor_msg_52">
    <text>Я не хочу помирати</text>
  </string>
  <string id="st_lab_tier_actor_msg_53">
    <text>Я більше не можу</text>
  </string>
  <string id="st_lab_tier_actor_msg_54">
    <text>Хтось провів пальцем по потилиці</text>
  </string>
  <string id="st_lab_tier_actor_msg_55">
    <text>Серце калатає в грудях</text>
  </string>
  <string id="st_lab_tier_actor_msg_56">
    <text>Я чую якийсь шепіт</text>
  </string>
  <string id="st_lab_tier_actor_msg_57">
    <text>Неприємне відчуття липкого павутиння</text>
  </string>
  <string id="st_lab_tier_actor_msg_58">
    <text>Повітря згустилося, наче стало рідким</text>
  </string>
  <string id="st_lab_tier_actor_msg_6">
    <text>Я чую якісь крики</text>
  </string>
  <string id="st_lab_tier_actor_msg_7">
    <text>Я чую якийсь сморід</text>
  </string>
  <string id="st_lab_tier_actor_msg_8">
    <text>Щось не так</text>
  </string>
  <string id="st_lab_tier_actor_msg_9">
    <text>Волосся на потилиці стає дибки</text>
  </string>
