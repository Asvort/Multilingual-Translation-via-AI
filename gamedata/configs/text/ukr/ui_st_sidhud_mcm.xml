<?xml version="1.0" encoding="windows-1251"?>
<string_table>
  <string id="ui_mcm_menu_sidhud">
    <text>SidHUD</text>
  </string>
  <string id="ui_mcm_sidhud_ammoshow">
    <text>Загальний лічильник набоїв</text>
  </string>
  <string id="ui_mcm_sidhud_ammoshow_desc">
    <text>Показує ЗАГАЛЬНУ кількість набоїв кожного з 3 типів, доступних в інвентарі.</text>
  </string>
  <string id="ui_mcm_sidhud_armorbar">
    <text>Індикатор стану броні</text>
  </string>
  <string id="ui_mcm_sidhud_armorbar_desc">
    <text>Показує індикатор стану броні.</text>
  </string>
  <string id="ui_mcm_sidhud_armortext">
    <text>Текст стану броні</text>
  </string>
  <string id="ui_mcm_sidhud_armortext_desc">
    <text>Показує стан броні у відсотках блакитним текстом. \n%c[ui_gray_2]Не діє, якщо індикатор вимкнено.</text>
  </string>
  <string id="ui_mcm_sidhud_bleedingbarshow">
    <text>Індикатор кровотечі</text>
  </string>
  <string id="ui_mcm_sidhud_bleedingbarshow_desc">
    <text>Показує обсяг втраченої крові на шкалі витривалості зліва направо. </text>
  </string>
  <string id="ui_mcm_sidhud_healingbar">
    <text>Індикатор прогнозу лікування</text>
  </string>
  <string id="ui_mcm_sidhud_healingbar_desc">
    <text>Додає до шкали здоров’я ледь помітний індикатор, що показує точну кількість здоров’я, яку відновить лікувальний предмет.</text>
  </string>
  <string id="ui_mcm_sidhud_oldammoshow">
    <text>Старі набої</text>
  </string>
  <string id="ui_mcm_sidhud_oldammoshow_desc">
    <text>Показує старі набої, коли це доречно (наприклад, якщо в них немає «покращених» аналогів).</text>
  </string>
  <string id="ui_mcm_sidhud_radhealthshow">
    <text>Індикатор радіаційного опромінення</text>
  </string>
  <string id="ui_mcm_sidhud_radhealthshow_desc">
    <text>Показує рівень радіації на шкалі здоров’я зліва направо. </text>
  </string>
  <string id="ui_mcm_sidhud_sidslide">
    <text>Налаштування SidHUD</text>
  </string>
  <string id="ui_mcm_sidhud_weaponbarhide">
    <text>Ховати після зняття</text>
  </string>
  <string id="ui_mcm_sidhud_weaponbarhide_desc">
    <text>Ховає індикатор стану зброї, коли її знято. \n%c[ui_gray_2]Не діє, якщо індикатор вимкнено.</text>
  </string>
  <string id="ui_mcm_sidhud_weaponshow">
    <text>Індикатор стану зброї</text>
  </string>
  <string id="ui_mcm_sidhud_weaponshow_desc">
    <text>Показує індикатор стану зброї.</text>
  </string>
  <string id="ui_mcm_sidhud_weapontext">
    <text>Текст стану зброї</text>
  </string>
  <string id="ui_mcm_sidhud_weapontext_desc">
    <text>Показує стан зброї у відсотках помаранчевим текстом. \n%c[ui_gray_2]Не діє, якщо індикатор вимкнено.</text>
  </string>
</string_table>
