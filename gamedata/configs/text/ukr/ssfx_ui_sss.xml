<?xml version="1.0" encoding="windows-1251"?>
<string_table>
  <string id="ui_mcm_ssfx_module_sss">
    <text>SSS</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_enable_dir_mcm">
    <text>Увімкнути тіні від спрямованого світла</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_enable_dir_mcm_desc">
    <text>Вмикає або вимикає екранні тіні від спрямованого світла (сонця й місяця).</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_enable_point_mcm">
    <text>Увімкнути тіні від точкових джерел</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_enable_point_mcm_desc">
    <text>Вмикає або вимикає екранні тіні від точкових джерел (ламп, багать тощо).</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_len_dir_mcm">
    <text>Довжина тіней від спрямованого світла</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_len_dir_mcm_desc">
    <text>Налаштовує максимальну довжину тіней від спрямованого світла.</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_len_point_mcm">
    <text>Довжина тіней від точкових джерел</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_len_point_mcm_desc">
    <text>Налаштовує максимальну довжину всіх тіней від точкових джерел.</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_quality_dir_mcm">
    <text>Якість тіней від спрямованого світла</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_quality_dir_mcm_desc">
    <text>Кількість вибірок для тіней від спрямованого світла (сонця й місяця). Більше вибірок покращує чіткість тіней. [ 6 - 12 - 18 - 24 ]</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_quality_point_mcm">
    <text>Якість тіней від точкових джерел</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_quality_point_mcm_desc">
    <text>Кількість вибірок для тіней від точкових джерел (ламп, багать тощо). Більше вибірок покращує чіткість тіней. [ 2 - 4 - 6 - 8 ]</text>
  </string>
  <string id="ui_mcm_ssfx_module_sss_title">
    <text>Налаштування екранних тіней</text>
  </string>
</string_table>
